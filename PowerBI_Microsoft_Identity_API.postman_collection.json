{
	"info": {
		"_postman_id": "a8f3e2b1-5c6d-4e9f-8a7b-3c2d1e0f9a8b",
		"name": "ERP API - Microsoft Identity Authentication",
		"description": "Postman Collection for testing ERP PowerBI APIs secured with Microsoft Entra ID (Azure AD) OAuth 2.0 / JWT Authentication.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "AZURE_TENANT_ID",
			"value": "YOUR_MICROSOFT_TENANT_ID",
			"type": "string"
		},
		{
			"key": "AZURE_CLIENT_ID",
			"value": "YOUR_AZURE_CLIENT_ID",
			"type": "string"
		},
		{
			"key": "AZURE_CLIENT_SECRET",
			"value": "YOUR_AZURE_CLIENT_SECRET",
			"type": "string"
		},
		{
			"key": "microsoft_access_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Get Microsoft Bearer Token (Client Credentials)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.collectionVariables.set('microsoft_access_token', jsonData.access_token);",
									"    console.log('Successfully acquired Microsoft Access Token');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "{{AZURE_CLIENT_ID}}",
									"type": "text"
								},
								{
									"key": "client_secret",
									"value": "{{AZURE_CLIENT_SECRET}}",
									"type": "text"
								},
								{
									"key": "scope",
									"value": "api://{{AZURE_CLIENT_ID}}/.default",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "https://login.microsoftonline.com/{{AZURE_TENANT_ID}}/oauth2/v2.0/token",
							"protocol": "https",
							"host": [
								"login",
								"microsoftonline",
								"com"
							],
							"path": [
								"{{AZURE_TENANT_ID}}",
								"oauth2",
								"v2.0",
								"token"
							]
						},
						"description": "Requests an OAuth 2.0 Bearer access token from Microsoft Identity Platform for your organization. Automatically saves token into {{microsoft_access_token}} variable."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. PowerBI Secure APIs",
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{microsoft_access_token}}",
						"type": "string"
					}
				]
			},
